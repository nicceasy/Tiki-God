    { "match": "^ketel one (citroen|oranje)|^absolut (lime|citron)", "id": "vodka", "orig": true, "approx": true },
    { "match": "vodka", "id": null, "why": "flavored vodka" },
    { "match": "^cognac|^armagnac|^spanish brandy|^italian brandy", "id": "brandy", "orig": true },
    { "match": "^calvados|^applejack", "id": "applejack", "orig": true },
