{
  "about": "Ingredient-string → ingredient-id rules for scripts/import/difford.mjs (Difford's Guide scrape, LauraMarby/IA-SRI-SIM_Project). Each rule's `match` is a case-insensitive regex tested against the ingredient name AFTER the amount/unit prefix, 'Top up with', 'Float' and the word 'optional' are stripped. First matching rule wins, so specific rules precede generic ones. Fields: id (an id from data/ingredients.json; null = deliberately unmappable, with `why`), drop (true = not an ingredient for our purposes: dilution compensation, texture agents, spent shells), orig (true = keep the Difford's wording in `orig`), approx (true = flavor-adjacent stand-in; a KEY ingredient mapped this way lowers the record to confidence 'low'), scale (multiply the converted amount: e.g. raw honey → 2× 1:1 honey syrup), count (how count-style units — fresh, whole, wedge, slice, ring, cube, sprig, leaf, inch, dried, scoop, knob — convert: {unit} keeps the count in one of our units, {oz} gives ounces per item, {tsp} teaspoons per item; key `default` applies to any count unit not listed). Strings with no matching rule are reported as unmappable.",
  "version": 1,
  "rules": [
    { "match": "^chilled water (omit|reduce)", "drop": true, "why": "Difford's adds chilled water to stirred/shaken drinks only to compensate for dry, very cold ice; our specs assume normal ice dilution." },
    { "match": "^xanthan gum", "drop": true, "why": "texture agent, no flavor" },
    { "match": "^lime shell", "drop": true, "why": "spent lime shell is a garnish" },
    { "match": "^\\*special ingredient", "id": null, "why": "house-made preparation whose recipe is not in the scrape" },
    { "match": "infused|fat[- ]washed|oleo[- ]saccharum|marinade|marinated", "id": null, "why": "house infusion / preparation" },
    { "match": "^brandy, whisk\\(e\\)y, gin, rum", "id": null, "why": "unspecified base spirit" },

    { "match": "^light white rum|^white rum|^light rum", "id": "rum-white-column", "orig": true },
    { "match": "^bacardi carta blanca", "id": "rum-white-column", "orig": true },
    { "match": "^light gold rum|^bacardi gold", "id": "rum-gold-column", "orig": true },
    { "match": "^gold rum \\(1-3 years old pot & column", "id": "rum-blended-light", "orig": true },
    { "match": "^bacardi 8|^aged column", "id": "rum-aged-column", "orig": true },
    { "match": "^bacardi carta negra", "id": "rum-black-blended", "orig": true },
    { "match": "^caribbean blended rum aged|^aged rum \\(blended\\)|^blended aged rum", "id": "rum-barbados", "orig": true },
    { "match": "^jamaican-style overproof aged pot still|^pot[- ]still jamaican|^jamaican pot[- ]still", "id": "rum-jamaican-pot", "orig": true },
    { "match": "^jamaican aged blended rum|^aged jamaican", "id": "rum-jamaican-aged", "orig": true },
    { "match": "^white overproof rum|^jamaican (white )?overproof", "id": "rum-jamaican-white-overproof", "orig": true },
    { "match": "^navy rum", "id": "rum-navy", "orig": true },
    { "match": "^dark/black/blackstrap rum|^blackstrap|^black rum", "id": "rum-black-blended", "orig": true },
    { "match": "demerara 151|overproof demerara", "id": "rum-demerara-overproof", "orig": true },
    { "match": "^demerara rum|^guyan", "id": "rum-demerara", "orig": true },
    { "match": "^rhum cl[ée]ment blanc|^rhum agricole blanc|^agricole blanc", "id": "rum-agricole-blanc", "orig": true },
    { "match": "^martinique v\\.?s\\.?o\\.?p|^rhum agricole (vieux|ambr)|^aged rhum agricole", "id": "rum-agricole-vieux", "orig": true },
    { "match": "spiced rum", "id": "rum-spiced", "orig": true },
    { "match": "^pineapple rum", "id": "rum-pineapple", "orig": true },
    { "match": "^vanilla rum", "id": null, "why": "vanilla-flavored rum" },
    { "match": "^cacha[cç]a", "id": "rum-cachaca", "orig": true },
    { "match": "^batavia arrack", "id": "batavia-arrack" },
    { "match": "^coconut (rum )?liqueur", "id": "coconut-rum", "orig": true },
    { "match": "^rhum cl[ée]ment cr[ée]ole shrubb", "id": "orange-curacao", "orig": true },

    { "match": "^hayman's old tom", "id": "gin-old-tom", "orig": true },
    { "match": "^hayman's london dry gin|london dry gin", "id": "gin", "orig": true },
    { "match": "^rutte celery dry gin", "id": "gin", "orig": true, "approx": true },
    { "match": "genever|jenever", "id": null, "why": "malty genever has no stand-in" },
