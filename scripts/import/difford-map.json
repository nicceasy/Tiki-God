    { "match": "^sugar syrup 'rich'|^gomme syrup|sirop de canne|^cane syrup", "id": "rich-simple", "orig": false },
    { "match": "^caster|superfine|^powdered sugar|^granulated sugar", "id": "rich-simple", "orig": true, "count": { "default": { "tsp": 1 } } },
    { "match": "^sugar cube \\(white\\)", "id": "rich-simple", "orig": true, "count": { "default": { "tsp": 1 } } },
